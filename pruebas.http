############################################################
# Solee API - pruebas con REST Client
# Requiere el backend corriendo (npm run dev).
# Cada bloque ### se ejecuta solo con "Send Request" o Ctrl+Alt+R.
############################################################

@baseUrl = http://localhost:5000/api

############################################################
# 0. HEALTH CHECK (confirma que el servidor esta arriba)
############################################################

### Health -> esperado 200 { status: "ok" }
GET {{baseUrl}}/health

### Registro participante -> esperado 201
# @name registro
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Camila Rojas",
  "email": "camila@solee.com",
  "password": "Camila1234",
  "confirmPassword": "Camila1234",
  "rol": "participante",
  "rut": "12.345.678-5",
  "fechaNacimiento": "1998-05-14",
  "telefono": "+56 9 1234 5678",
  "comuna": "Ñuñoa",
  "intereses": ["música", "teatro"],
  "aceptaTerminos": true
}

############################################################
# 1. AUTENTICACION (confirmar ruta en authRoutes)
############################################################

### Login organizador (guarda el token)
# @name loginOrg
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "organizador@solee.com",
  "password": "Test1234"
}

### Login participante (para probar el bloqueo por rol)
# @name loginPart
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "participante@test.cl",
  "password": "123456"
}

############################################################
# 2. ACTIVIDADES - rutas publicas
############################################################

### Buscar todas las actividades -> esperado 200
GET {{baseUrl}}/actividades

### Buscar con filtros (ajustar nombres de query params al controller)
GET {{baseUrl}}/actividades?disciplina=cerámica&modalidad=presencial&nivel=principiante

############################################################
# 3. ACTIVIDADES - rutas protegidas (organizador)
############################################################

### Crear actividad PRESENCIAL como organizador -> esperado 201
# @name crear
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Taller de cerámica para principiantes",
  "descripcion": "Taller introductorio de modelado en arcilla. Incluye materiales.",
  "disciplina": "cerámica",
  "nivel": "principiante",
  "modalidad": "presencial",
  "precio": 15000,
  "cupoMaximo": 12,
  "cuposDisponibles": 12,
  "ubicacion": {
    "type": "Point",
    "coordinates": [-70.6109, -33.4263]
  },
  "direccionTexto": "Av. Providencia 1234, Providencia",
  "fechaInicio": "2026-11-21T15:00:00.000Z",
  "fechaFin": "2026-11-21T18:00:00.000Z",
  "horario": "tarde"
}

### Crear actividad VIRTUAL sin ubicacion -> esperado 201 (valida que 2dsphere no se rompa)
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Escritura creativa online",
  "descripcion": "Sesiones por Zoom para desarrollar relatos breves.",
  "disciplina": "escritura",
  "nivel": "todos los niveles",
  "modalidad": "virtual",
  "precio": 0,
  "cupoMaximo": 30,
  "cuposDisponibles": 30,
  "fechaInicio": "2026-11-25T22:00:00.000Z",
  "fechaFin": "2026-11-25T23:30:00.000Z",
  "horario": "noche"
}

### Obtener la actividad recien creada por ID -> esperado 200
GET {{baseUrl}}/actividades/{{crear.response.body._id}}

### Mis actividades como organizador -> esperado 200
GET {{baseUrl}}/actividades/mis-actividades
Authorization: Bearer {{loginOrg.response.body.$.token}}

############################################################
# 4. CASOS NEGATIVOS - seguridad
############################################################

### Mis actividades sin token -> esperado 401
GET {{baseUrl}}/actividades/mis-actividades

### Mis actividades como participante -> esperado 403
GET {{baseUrl}}/actividades/mis-actividades
Authorization: Bearer {{loginPart.response.body.$.token}}

### Crear actividad como participante -> esperado 403
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginPart.response.body.$.token}}

{
  "titulo": "No deberia crearse"
}

### Crear actividad con token falso -> esperado 401
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer token-inventado-123

{
  "titulo": "No deberia crearse"
}

############################################################
# 5. CASOS NEGATIVOS - validacion del modelo
############################################################

### Faltan campos obligatorios -> esperado 400
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Actividad incompleta"
}

### Disciplina fuera del enum -> esperado 400
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Clase de cocina",
  "descripcion": "No es una disciplina permitida",
  "disciplina": "cocina",
  "nivel": "principiante",
  "modalidad": "presencial",
  "precio": 5000,
  "cupoMaximo": 10,
  "cuposDisponibles": 10,
  "fechaInicio": "2026-11-21T15:00:00.000Z",
  "fechaFin": "2026-11-21T18:00:00.000Z",
  "horario": "tarde"
}

### Precio negativo y cupo 0 -> esperado 400
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Datos invalidos",
  "descripcion": "Precio bajo el minimo y cupo bajo el minimo",
  "disciplina": "danza",
  "nivel": "intermedio",
  "modalidad": "presencial",
  "precio": -100,
  "cupoMaximo": 0,
  "cuposDisponibles": 0,
  "fechaInicio": "2026-11-21T15:00:00.000Z",
  "fechaFin": "2026-11-21T18:00:00.000Z",
  "horario": "tarde"
}

### Titulo sobre 120 caracteres -> esperado 400
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Este titulo es demasiado largo a proposito para comprobar que la validacion maxlength de ciento veinte caracteres funciona bien",
  "descripcion": "Prueba de maxlength",
  "disciplina": "teatro",
  "nivel": "avanzado",
  "modalidad": "híbrida",
  "precio": 0,
  "cupoMaximo": 5,
  "cuposDisponibles": 5,
  "fechaInicio": "2026-11-21T15:00:00.000Z",
  "fechaFin": "2026-11-21T18:00:00.000Z",
  "horario": "fin de semana"
}

############################################################
# 6. CASOS NEGATIVOS - IDs
############################################################

### Obtener actividad con ID inexistente -> esperado 404
GET {{baseUrl}}/actividades/000000000000000000000000

### Obtener actividad con ID mal formado -> esperado 400 (500 si no esta controlado)
GET {{baseUrl}}/actividades/abc123



############################################################
# 7. EDITAR Y ELIMINAR (US-11)
# Orden: loginOrg, registro y login del colectivo, crearParaEditar y luego las pruebas.
############################################################

### Registrar una organizacion para probar el 403 -> esperado 201 (409 si ya existe)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Colectivo Demo",
  "email": "colectivo.demo@solee.com",
  "password": "Demo12345",
  "confirmPassword": "Demo12345",
  "rol": "organizador",
  "tipoCuenta": "organizacion",
  "rut": "76.123.456-0",
  "aceptaTerminos": true
}

### Login de la otra organizacion -> esperado 200
# @name loginColectivo
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "colectivo.demo@solee.com",
  "password": "Demo12345"
}

### Crear una actividad propia para editar -> esperado 201
# @name crearParaEditar
POST {{baseUrl}}/actividades
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{
  "titulo": "Taller de grabado en linóleo",
  "descripcion": "Taller práctico de grabado para principiantes. Materiales incluidos.",
  "disciplina": "artes visuales",
  "nivel": "principiante",
  "modalidad": "presencial",
  "precio": 12000,
  "cupoMaximo": 12,
  "ubicacion": { "type": "Point", "coordinates": [-70.6320, -33.4410] },
  "direccionTexto": "Barrio Lastarria, Santiago",
  "fechaInicio": "2026-11-21T14:00:00.000Z",
  "fechaFin": "2026-11-21T17:00:00.000Z",
  "horario": "tarde"
}

### Editar sin token -> esperado 401
PUT {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Content-Type: application/json

{ "precio": 9000 }

### Editar con otra organizacion -> esperado 403
PUT {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Content-Type: application/json
Authorization: Bearer {{loginColectivo.response.body.$.token}}

{ "precio": 9000 }

### Editar siendo la dueña -> esperado 200
PUT {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{ "precio": 9000, "titulo": "Taller de grabado en linóleo (cupos ampliados)", "cupoMaximo": 20 }

### Pausar -> esperado 200
PUT {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{ "estado": "pausada" }

### Estado invalido -> esperado 400
PUT {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Content-Type: application/json
Authorization: Bearer {{loginOrg.response.body.$.token}}

{ "estado": "eliminada" }

### Eliminar con otra organizacion -> esperado 403
DELETE {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Authorization: Bearer {{loginColectivo.response.body.$.token}}

### Eliminar siendo la dueña -> esperado 200
DELETE {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Authorization: Bearer {{loginOrg.response.body.$.token}}

### Despues de eliminar, el detalle -> esperado 404
GET {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}

### Eliminar de nuevo -> esperado 404
DELETE {{baseUrl}}/actividades/{{crearParaEditar.response.body.$._id}}
Authorization: Bearer {{loginOrg.response.body.$.token}}

### US-05: solo ordenar por cercania, sin radio -> esperado 200, con distanciaMetros ascendente y las virtuales al final
GET {{baseUrl}}/actividades?lat=-33.4372&lng=-70.6180