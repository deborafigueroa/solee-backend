############################################################
# Solee API - Pruebas 1 de 3: cuentas, actividades y busqueda
# REST Client no ejecuta todo junto: envia cada bloque en orden con "Send Request"
# (Ctrl+Alt+R). Las variables "# @name" existen solo despues de enviar esa peticion.
# Las cuentas QA se crean en la seccion 1: 201 la primera vez y 409 las siguientes.
############################################################

@baseUrl = http://localhost:5000/api
@clave = Prueba1234

############################################################
# 0. SALUD
############################################################

### 0.1 Salud -> esperado 200 con "bd": "conectada"
GET {{baseUrl}}/health

############################################################
# 1. REGISTRO (US-01, US-02, US-03)
############################################################

### 1.1 Organizador persona natural -> esperado 201 (409 si ya existe)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "QA Organizador",
  "email": "qa.org@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "organizador",
  "tipoCuenta": "persona",
  "rut": "13.131.313-6",
  "fechaNacimiento": "1990-03-20",
  "aceptaTerminos": true
}

### 1.2 Participante 1 con intereses -> esperado 201 (409 si ya existe)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "QA Participante Uno",
  "email": "qa.part1@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "participante",
  "rut": "14.141.414-3",
  "fechaNacimiento": "1998-05-14",
  "telefono": "+56 9 1234 5678",
  "comuna": "Ñuñoa",
  "intereses": ["teatro", "música"],
  "aceptaTerminos": true
}

### 1.3 Participante 2 -> esperado 201 (409 si ya existe)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "QA Participante Dos",
  "email": "qa.part2@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "participante",
  "rut": "16.161.616-8",
  "fechaNacimiento": "1996-08-02",
  "aceptaTerminos": true
}

### 1.4 Organizacion, sin fecha de nacimiento -> esperado 201 (409 si ya existe)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "QA Colectivo",
  "email": "qa.org2@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "organizador",
  "tipoCuenta": "organizacion",
  "rut": "77.123.123-3",
  "aceptaTerminos": true
}

### 1.5 Correo duplicado -> esperado 409 "Este correo ya esta registrado"
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Otra Persona",
  "email": "qa.org@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "participante",
  "rut": "17.171.717-5",
  "fechaNacimiento": "1995-01-10",
  "aceptaTerminos": true
}

### 1.6 RUT duplicado con otro correo -> esperado 409 "Ya existe una cuenta con este RUT"
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Otra Persona",
  "email": "qa.otro@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "participante",
  "rut": "13.131.313-6",
  "fechaNacimiento": "1995-01-10",
  "aceptaTerminos": true
}

### 1.7 RUT con digito verificador incorrecto -> esperado 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Rut Malo",
  "email": "qa.rutmalo@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "participante",
  "rut": "67.880.888-3",
  "fechaNacimiento": "1995-01-10",
  "aceptaTerminos": true
}

### 1.8 Contrasena debil -> esperado 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Clave Debil",
  "email": "qa.debil@solee.com",
  "password": "abc",
  "confirmPassword": "abc",
  "rol": "participante",
  "rut": "17.171.717-5",
  "fechaNacimiento": "1995-01-10",
  "aceptaTerminos": true
}

### 1.9 Menor de edad -> esperado 400 "Debes ser mayor de 18 anos"
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Menor",
  "email": "qa.menor@solee.com",
  "password": "{{clave}}",
  "confirmPassword": "{{clave}}",
  "rol": "participante",
  "rut": "17.171.717-5",
